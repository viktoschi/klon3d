        <pieces>
            <piece color="#ffffff" fill="nobrush" forbidFlipping="true" hideMainPath="false" id="799" inLayout="true" locked="false" mx="0" my="-8" name="Bischofaermel links 1x" seamAllowance="true" united="false" version="2" width="#SeamOverlap">
                <data annotation="0,40 mm, 1x. 6-mm-Klebestreifen rundum. Kugel in 7 Kellerfalten ueber der Schulter, Saum in 6 Kellerfalten in die Manschette. V-Kerben = Bruch, Doppelstrich = Mitte, dort treffen sich die Bruchkanten (SPT = Mitte KF4 auf die Schulternaht). Einfachstrich = Passzeichen; vorn zwei Striche 2 cm auseinander (SQB_R, Zeichen C - das untere Paar; darueber FKZ_R und SXB_R 2,2 cm auseinander), hinten SQB_L und SQM_L (Mitte der Rundung). Unterarmnaht: vordere Kante (SB_R) oben." foldPosition="Undefined" fontSize="0" height="2" letter="AE-L" mx="2" my="2" onFold="false" orientation="Undefined" quantity="1" rotation="0" rotationWay="None" tilt="None" visible="true" width="6"><line alignment="0" bold="true" italic="false" sfIncrement="6" text="%pLetter%" /><line alignment="0" bold="true" italic="false" sfIncrement="1" text="%pName%" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="Zuschnitt %pQuantity%x" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="0,40 mm" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="Zugabe statt Reduktion" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="%date%" /></data>
