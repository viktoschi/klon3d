        <pieces>
            <piece color="#ffffff" fill="nobrush" forbidFlipping="true" hideMainPath="false" id="599" inLayout="true" locked="false" mx="-6" my="0" name="Rueckenteil 1x" seamAllowance="true" united="false" version="2" width="#SeamOverlap">
                <data annotation="0,40 mm, 1x. 6-mm-Klebestreifen: Halsloch, Schultern, Armloecher, Seitennaehte. Frei: Saum. Matte Seite nach oben anzeichnen, nicht spiegeln. Vorderteile liegen an Schulter und Seite oben, der Koerper liegt auf der Kugel. Passzeichen RNP = Kragenmitte. Doppelstriche am Armloch oben = fertige Faltenmitten der Kugel, RQM = Mitte der Rundung." foldPosition="Undefined" fontSize="0" height="2" letter="RT" mx="2" my="2" onFold="false" orientation="Undefined" quantity="1" rotation="0" rotationWay="None" tilt="None" visible="true" width="6"><line alignment="0" bold="true" italic="false" sfIncrement="6" text="%pLetter%" /><line alignment="0" bold="true" italic="false" sfIncrement="1" text="%pName%" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="Zuschnitt %pQuantity%x" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="0,4 mm" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="Reduktion Brust 5 %, Saum 8,5 %" /><line alignment="0" bold="false" italic="false" sfIncrement="0" text="%date%" /></data>
                <patternInfo fontSize="0" height="2" mx="2" my="12" rotation="0" visible="true" width="6" />
                <nodes>
