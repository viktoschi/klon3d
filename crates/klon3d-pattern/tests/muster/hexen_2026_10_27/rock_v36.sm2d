        <pieces>
            <piece color="#ffffff" fill="nobrush" forbidFlipping="true" hideMainPath="false" id="2201" inLayout="true" locked="false" mx="-35.9833" my="-74.0833" name="2 VORNE RECHTS - obere Lage an CF" seamAllowance="true" united="false" version="2" width="#SeamOverlap">
                <data annotation="SEIT v35 (Taille 70): oben an der Schlitzkante ein Keil weg, an der Oberkante #SlitTrimF 0,76 cm, auslaufend #SlitTrimDepth 20 cm tiefer (Schritt 3a); neue obere Schlitzecke TK_VR. LAGE: vordere Koerperhaelfte RECHTS, vordere Mitte bis rechter Schlitz. 0,40 mm schwarz, 1x. 6-mm-Klebestreifen: vordere Mitte (liegt OBEN auf Teil 3) und Oberkante. Frei: Schlitzkante und Saum. Passzeichen (v30 Runde 3): Mitte 8 (mit dem Knie-Zeichen, Abstand rund 10-12 cm), Schlitzkante 7 (fuer BL1, rund 12 cm), Oberkante 1 (Mitte des Abschnitts). Innen: an der Schlitzkante BL1 VR (gestrichelte Zone), an der oberen Schlitzecke VS1 VR und VS2 VR (gepunktete Zonen), darueber der Donut DN R. AUFLAGE: Latexbahn matte Seite nach oben, Schablone bedruckt nach oben, anzeichnen, schneiden, umdrehen - Glanzseite ist aussen." foldPosition="Undefiniert" fontSize="0" height="2" letter="2 V" mx="3101.23" my="1778.13" onFold="false" orientation="Undefiniert" quantity="1" rotation="0" rotationWay="Keine" tilt="Keine" visible="true" width="4">
