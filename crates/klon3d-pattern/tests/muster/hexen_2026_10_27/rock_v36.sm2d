        <pieces>
            <piece color="#ffffff" fill="nobrush" forbidFlipping="true" hideMainPath="false" id="2301" inLayout="true" locked="false" mx="0" my="0" name="BL1 VR Schlitzblende vorne rechts" seamAllowance="true" united="false" version="2" width="0">
                <data annotation="0,40 mm schwarz, 1x. LAGE: innen an der Schlitzkante von Teil 2 (vorne rechts). Aussenkante buendig mit der Schlitzkante, die ganze Breite auf der gestrichelten Klebezone der Bahn, oben buendig mit der Bahnoberkante, nicht um die Kante schlagen, aussen nicht sichtbar (Zusammenbau Schritt 4). Die Laengskante mit den 7 Passzeichen an die Schlitzkante, Zeichen auf die 7 Zeichen der Schlitzkante; oben buendig mit der Schnittkante der Bahnoberkante, unten rund 1,7 cm Ueberstand (v30 Runde 3). Wird flach aufkaschiert, deshalb keine Zugabe. In voller Laenge schneiden, ohne Zug auflegen, unten buendig nachschneiden. Ganzflaechig einstreichen, nicht nur 6 mm. Breite 1 cm (#TrimWidth, seit 07.10.2026; Working with Latex S. 488, Female Catsuit S. 508). AUFLAGE: Latexbahn matte Seite nach oben, Schablone bedruckt nach oben, anzeichnen, schneiden. Die matte Unterseite kommt auf die matte Innenseite der Bahn, die Glanzseite zeigt zum Koerper." foldPosition="Undefiniert" fontSize="0" height="1" letter="BL1 VR" mx="3" my="20" onFold="false" orientation="Undefiniert" quantity="1" rotation="0" rotationWay="Keine" tilt="Keine" visible="true" width="3">
                    <line alignment="0" bold="true" italic="false" sfIncrement="6" text="%pLetter%"/>
                    <line alignment="0" bold="true" italic="false" sfIncrement="1" text="%pName%"/>
                    <line alignment="0" bold="false" italic="false" sfIncrement="0" text="Zuschnitt %pQuantity%x"/>
                    <line alignment="0" bold="false" italic="false" sfIncrement="0" text="0,4 mm schwarz"/>
                    <line alignment="0" bold="false" italic="false" sfIncrement="0" text="Bund 6 % (1 mm), Bahnen 0 %"/>
                    <line alignment="0" bold="false" italic="false" sfIncrement="0" text="%date%"/>
                </data>
