nment="0" bold="false" italic="false" sfIncrement="0" text="%date%"/></data><patternInfo fontSize="0" height="2" mx="2" my="12" rotation="0" visible="true" width="6"/><nodes><node after="0" before="0" idObject="1353" type="NodePoint"/><node after="0" before="0" idObject="1354" type="NodePoint"/><node after="0" before="0" idObject="1355" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6"/><node after="0" before="0" idObject="1356" type="NodePoint"/><node after="0" before="0" idObject="1357" type="NodePoint"/><node after="0" before="0" idObject="1358" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6"/></nodes></piece><piece color="#ffffff" fill="nobrush" forbidFlipping="true" hideMainPath="false" id="1404" inLayout="true" locked="false" mx="180" my="120" name="Bustier - Rueckteil links" seamAllowance="true" united="false" version="2" width="0"><data annotation="Aussenlage 1,0 mm. Rumpf wird 2 x 1,0 mm laminiert (Entscheidung 13.10.2026); die Innenlage mit versetzten Stossnaehten folgt in v2. Teilungs- und Seitennaehte dieser Lage stossen ohne Zugabe (0 mm), Oberkante/Saum/hintere Mitte frei (0 mm). Hintere Mitte = Schnuerkante, die halbe Schnuerluecke (#LacingGap / 2) ist abgezogen. Kreuze = Oesenmitten (7 je Seite, Abstand #EyeletPitch), Metalloesen zweiteilig durch beide Lagen, dazwischen gummiertes Gewebeband (Compendium S.435/437, Bloecke S.207). Gestrichelt: Stab neben den Oesen zwischen den Lagen. Loecher erst nach dem Laminieren stanzen, etwas kleiner als die Oese (Compendium S.437). Passzeichen: Teilungsnaht an der Unterbrustlinie." foldPosition="Undefiniert" fontSize="0" height="2" letter="RT_L" mx="2" my="6" onFold="false" orientation="Undefiniert" quantity="1" rotation="0" rotationWay="Keine" tilt="Keine" visible="true" width="4"><line alignment="0" bold="true" italic="false" sfIncrement="6" text="%pLetter%"/><line alignment="0" bold="true" italic="false" sfIncrement=