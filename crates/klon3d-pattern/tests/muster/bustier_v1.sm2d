um/hintere Mitte frei (0 mm). Von der Teilungsnaht (unter dem Brustpunkt) bis zur Seitennaht. Oberkante vom Cup-Aussenrand (I) zur Seite. Gestrichelt: Stab an der Seitennaht zwischen den Lagen, Mitte #BoneInset innen, endet #BoneGap vor den Kanten. Passzeichen: Seitennaht an der Unterbrustlinie (SU), G, Rundungsende, F." foldPosition="Undefiniert" fontSize="0" height="2" letter="SVT_L" mx="2" my="6" onFold="false" orientation="Undefiniert" quantity="1" rotation="0" rotationWay="Keine" tilt="Keine" visible="true" width="4"><line alignment="0" bold="true" italic="false" sfIncrement="6" text="%pLetter%"/><line alignment="0" bold="true" italic="false" sfIncrement="1" text="%pName%"/><line alignment="0" bold="false" italic="false" sfIncrement="0" text="Zuschnitt %pQuantity%x"/><line alignment="0" bold="false" italic="false" sfIncrement="0" text="1,0 mm"/><line alignment="0" bold="false" italic="false" sfIncrement="0" text="keine Reduktion"/><line alignment="0" bold="false" italic="false" sfIncrement="0" text="%date%"/></data><patternInfo fontSize="0" height="2" mx="2" my="12" rotation="0" visible="true" width="6"/><nodes><node after="0" before="0" idObject="1320" type="NodePoint"/><node after="0" before="0" idObject="1321" type="NodePoint"/><node after="0" before="0" idObject="1322" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6"/><node after="0" before="0" idObject="1323" type="NodePoint"/><node after="0" before="0" idObject="1324" reverse="1" type="NodeSpline"/><node after="0" before="0" idObject="1325" type="NodePoint"/><node after="0" before="0" idObject="1326" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6"/><node after="0" before="0" idObject="1327" type="NodePoint" notch="true" notchType="slit" notchSubtype="straightforward" notchLength="0.6"/><node after="0" before="0" idObject="1328" reverse="0" type="NodeArc"/><node after="0" before="0" idObject="1329" type="NodePoin