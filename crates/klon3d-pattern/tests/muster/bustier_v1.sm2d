<draftBlock name="Kontrolle"><calculation><point id="1415" mx="0.15" my="0.15" name="K0" type="single" x="10" y="10"/><point id="1416" mx="0.15" my="0.15" name="KI0" type="single" x="40" y="10"/><point angle="0" basePoint="1415" id="1417" length="10 * abs(Line_WS_R_SU_R + Line_SU_R_ST_R - Line_BW_R_BSU_R - Line_BSU_R_BST_R)" lineColor="black" lineType="solidLine" mx="0.3" my="0.3" name="K1" type="endLine"/><point angle="15" basePoint="1415" id="1418" length="10 * abs(Line_OJ_R_OK_R - Line_J_R_A_R - Line_A_R_K_R)" lineColor="black" lineType="solidLine" mx="0.3" my="0.3" name="K2" type="endLine"/><point angle="30" basePoint="1416" id="1419" length="#CupCone" lineColor="blue" lineType="solidLine" mx="0.3" my="0.3" name="K3" type="endLine"/><point angle="45" basePoint="1415" id="1420" length="10 * ((#EyeletPitch &gt; 2.8) * (#EyeletPitch - 2.8) + (#EyeletPitch &lt; 1.8) * (1.8 - #EyeletPitch))" lineColor="black" lineType="solidLine" mx="0.3" my="0.3" name="K4" type="endLine"/><point angle="60" basePoint="1415" id="1421" length="10 * abs(Line_CE_R_G_R + Line_G_R_CE2_R - (#CupOuterX - #BridgeHalf - 2 * #CornerR))" lineColor="black" lineType="solidLine" mx="0.3" my="0.3" name="K5" type="endLine"/><point angle="75" basePoint="1416" id="1422" length="#UBHeight + #LowerCupDepth + #UpperCupHeight" lineColor="blue" lineType="solidLine" mx="0.3" my="0.3" name="K6" type="endLine"/><point angle="90" basePoint="1415" id="1423" length="10 * ((#CupOuterX - #ApexX &lt; 2) * (2 - (#CupOuterX - #ApexX)))" lineColor="black" lineType="solidLine" mx="0.3" my="0.3" name="K7" type="endLine"/></calculation><modeling></modeling><pieces></pieces></draftBlock>
